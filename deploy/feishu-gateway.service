# 独立部署的飞书个人 Web 常驻网关 systemd 系统服务模板（真正跨 OS 用户隔离边界）。
#
# 部署步骤：
#   1. 创建专用低权用户与客户端访问组：
#        sudo groupadd --system feishu-gw-client
#        sudo useradd --system --home-dir /var/lib/feishu-gateway --create-home --shell /usr/sbin/nologin feishu-gw
#        sudo usermod -aG feishu-gw-client <运行 Avatar 的用户名>
#   2. 准备目录与密钥（配置目录允许 feishu-gw 遍历，secrets 子目录仅 root/systemd 可读）：
#        sudo install -d -m 0750 -o root -g feishu-gw /etc/feishu-gateway
#        sudo install -d -m 0700 -o root -g root /etc/feishu-gateway/secrets
#        openssl rand -hex 32 | sudo tee /etc/feishu-gateway/secrets/feishu-gw-key >/dev/null
#        openssl rand -base64 32 | tr '+/' '-_' | tr -d '=' | sudo tee /etc/feishu-gateway/secrets/read-token >/dev/null
#        openssl rand -base64 32 | tr '+/' '-_' | tr -d '=' | sudo tee /etc/feishu-gateway/secrets/reply-token >/dev/null
#        sudo chmod 0600 /etc/feishu-gateway/secrets/*
#   3. 准备配置文件 /etc/feishu-gateway/gateway.yaml（仅 feishu-gw 可读，不给 feishu-gw-client 权限）：
#        sudo install -m 0600 -o feishu-gw -g root /opt/avatar/gateway.example.yaml /etc/feishu-gateway/gateway.yaml
#        # 将其中 data_dir 改为 /var/lib/feishu-gateway，listen.socket 改为 /run/feishu-gateway/gateway.sock，
#        # listen.socket_mode 保持 "0660"，allow_reply 默认 false
#   4. 首次以 feishu-gw 身份通过 systemd Credential 扫码登录（密钥不进入进程 argv / cmdline）：
#        sudo systemd-run --pty --wait --collect \
#          -p User=feishu-gw -p Group=feishu-gw-client -p SupplementaryGroups=feishu-gw \
#          -p StateDirectory=feishu-gateway -p StateDirectoryMode=0700 \
#          -p Environment=FEISHU_GW_CONFIG=/etc/feishu-gateway/gateway.yaml \
#          -p LoadCredential=feishu-gw-key:/etc/feishu-gateway/secrets/feishu-gw-key \
#          /opt/avatar/bin/feishu-gateway login
#   5. 安装并启动服务：
#        sudo cp deploy/feishu-gateway.service /etc/systemd/system/
#        sudo systemctl daemon-reload && sudo systemctl enable --now feishu-gateway
#        sudo journalctl -u feishu-gateway -f
#
# 隔离效果与边界：
#   - /var/lib/feishu-gateway (0700) 中的加密 Cookie、SQLite 缓存和 /etc/feishu-gateway/secrets/* 对 Avatar 不可读；
#   - Avatar 及其 --approve-all harness worker 属于 feishu-gw-client 组，可以连接 /run/feishu-gateway/gateway.sock；
#   - 注意：与 Avatar 同一 OS 用户的 worker 能通过 /proc/<avatar-pid>/environ 或 Avatar 的凭据目录读到 read_token / reply_token，
#     拿到 read_token 即可读取任意会话历史与全部缓存，allow_reply 开启时拿到 reply_token 还能以本人身份发消息。
#     环境变量剥离只能阻止子进程继承，挡不住同用户读取；需要真正隔离时，请让派单 worker 以独立 OS 用户（或容器）运行。

[Unit]
Description=Feishu Personal Web Gateway (isolated daemon)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=feishu-gw
Group=feishu-gw-client
SupplementaryGroups=feishu-gw
UMask=0077
WorkingDirectory=/opt/avatar
Environment=FEISHU_GW_CONFIG=/etc/feishu-gateway/gateway.yaml
ExecStart=/opt/avatar/bin/feishu-gateway run
Restart=always
RestartSec=5

# 运行时 Socket 目录（0750，属组 feishu-gw-client 可穿越连接 socket）与私有状态目录（0700）
RuntimeDirectory=feishu-gateway
RuntimeDirectoryMode=0750
StateDirectory=feishu-gateway
StateDirectoryMode=0700

# 通过 systemd Credential 注入密钥与令牌（不暴露到全局环境变量或 cmdline）
LoadCredential=feishu-gw-key:/etc/feishu-gateway/secrets/feishu-gw-key
LoadCredential=read-token:/etc/feishu-gateway/secrets/read-token
LoadCredential=reply-token:/etc/feishu-gateway/secrets/reply-token

# 系统级加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/feishu-gateway /run/feishu-gateway
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
