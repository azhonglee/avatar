# 独立部署的飞书个人 Web 常驻网关 systemd 系统服务模板（真正跨 OS 用户隔离边界）。
#
# 部署步骤：
#   1. 创建专用低权用户与客户端访问组：
#        sudo groupadd --system feishu-gw-client
#        sudo useradd --system --home-dir /var/lib/feishu-gateway --create-home --shell /usr/sbin/nologin feishu-gw
#        sudo usermod -aG feishu-gw-client <运行 Avatar 的用户名>
#   2. 准备加密密钥与读写分离双令牌（仅 root / systemd 可读，勿放进代码目录）：
#        sudo install -d -m 0700 /etc/feishu-gateway
#        openssl rand -hex 32 | sudo tee /etc/feishu-gateway/feishu-gw-key >/dev/null
#        openssl rand -base64 32 | tr '+/' '-_' | tr -d '=' | sudo tee /etc/feishu-gateway/read-token >/dev/null
#        openssl rand -base64 32 | tr '+/' '-_' | tr -d '=' | sudo tee /etc/feishu-gateway/reply-token >/dev/null
#        sudo chmod 0600 /etc/feishu-gateway/*
#   3. 准备配置文件 /etc/feishu-gateway/gateway.yaml：
#        data_dir: /var/lib/feishu-gateway
#        listen:
#          socket: /run/feishu-gateway/gateway.sock
#          socket_mode: "0660"
#        allow_reply: false
#   4. 首次以 feishu-gw 身份扫码登录：
#        sudo -u feishu-gw FEISHU_GW_CONFIG=/etc/feishu-gateway/gateway.yaml \
#          FEISHU_GW_KEY="$(sudo cat /etc/feishu-gateway/feishu-gw-key)" \
#          /opt/avatar/bin/feishu-gateway login
#   5. 安装并启动服务：
#        sudo cp deploy/feishu-gateway.service /etc/systemd/system/
#        sudo systemctl daemon-reload && sudo systemctl enable --now feishu-gateway
#        sudo journalctl -u feishu-gateway -f
#
# 隔离效果：
#   - Avatar 及其 --approve-all harness worker 仅属于 feishu-gw-client 组，只能连接 /run/feishu-gateway/gateway.sock；
#   - /var/lib/feishu-gateway (0700) 中的加密 Cookie、SQLite 缓存和 /etc/feishu-gateway/feishu-gw-key 对 Avatar 不可读。

[Unit]
Description=Feishu Personal Web Gateway (isolated daemon)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=feishu-gw
Group=feishu-gw-client
UMask=0077
WorkingDirectory=/opt/avatar
Environment=FEISHU_GW_CONFIG=/etc/feishu-gateway/gateway.yaml
ExecStart=/opt/avatar/bin/feishu-gateway run
Restart=always
RestartSec=5

# 运行时 Socket 目录（0750，属组 feishu-gw-client 可穿越连接 socket）与私有状态目录（0700）
RuntimeDirectory=feishu-gateway
RuntimeDirectoryMode=0750
StateDirectory=feishu-gateway
StateDirectoryMode=0700

# 通过 systemd Credential 注入密钥与令牌（不暴露到全局环境变量）
LoadCredential=feishu-gw-key:/etc/feishu-gateway/feishu-gw-key
LoadCredential=read-token:/etc/feishu-gateway/read-token
LoadCredential=reply-token:/etc/feishu-gateway/reply-token

# 系统级加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/feishu-gateway /run/feishu-gateway
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
