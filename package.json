{
  "name": "personal-agent",
  "version": "0.1.0",
  "private": true,
  "description": "飞书个人 superagent：后台静默整理知识库、识别与追踪任务、提醒，并通过 ACP 调度多个 harness",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "pa": "bin/pa",
    "feishu-gateway": "bin/feishu-gateway"
  },
  "scripts": {
    "typecheck": "tsc",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "test:web": "vitest run --config web/vite.config.ts",
    "typecheck:web": "tsc -p web/tsconfig.json && tsc -p web/tsconfig.node.json",
    "demo:web": "node --experimental-strip-types --disable-warning=ExperimentalWarning web/scripts/demo-server.ts"
  },
  "dependencies": {
    "croner": "^9.1.0",
    "qrcode": "^1.5.4",
    "tough-cookie": "^6.1.0",
    "ws": "^8.23.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.18.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
